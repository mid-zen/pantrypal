# Get a free key (500 requests/month) at https://the-odds-api.com
ODDS_API_KEY=your-odds-api-key-here

# --- Alert channels (only needed for --watch mode) ---

# Discord: Server Settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=

# Telegram: create a bot via @BotFather to get the token, then message your bot
# and read your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Web dashboard (only needed when hosting it publicly) ---

# Set a password to lock the dashboard behind HTTP Basic auth. Leave blank for
# no auth (fine on your own machine / LAN, NOT fine on the public internet).
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# Port the web server listens on (hosts usually set this for you).
PORT=3000
